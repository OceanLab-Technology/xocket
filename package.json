{
  "name": "xocket",
  "version": "2.0.0",
  "description": "Xocket — Monorepo Development Platform CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "xocket": "./dist/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "!templates/**/node_modules",
    "!templates/**/package-lock.json",
    "!**/.DS_Store"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1",
    "picocolors": "^1.0.0"
  },
  "keywords": [
    "cli",
    "scaffold",
    "monorepo",
    "react",
    "nextjs",
    "turborepo",
    "pnpm"
  ],
  "author": "OceanLab Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OceanLab-Technology/xocket_template.git"
  },
  "bugs": {
    "url": "https://github.com/OceanLab-Technology/xocket_template/issues"
  },
  "homepage": "https://github.com/OceanLab-Technology/xocket_template#readme",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}