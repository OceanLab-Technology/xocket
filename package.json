{
  "name": "xocket",
  "version": "3.0.0",
  "description": "Xocket \u2014 scaffold production-ready TypeScript monorepos: React 19 / Next 16, Tailwind v4, Expo, polyglot services and SEO/AEO.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "xocket": "./dist/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "NOTICE",
    "!templates/**/node_modules",
    "!templates/**/*.lock",
    "!templates/**/pnpm-lock.yaml",
    "!**/.DS_Store"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "postbuild": "node --input-type=module -e \"import{chmodSync}from'node:fs';chmodSync('dist/index.js',0o755)\"",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "verify:output": "node scripts/verify-output.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "cli",
    "scaffold",
    "monorepo",
    "turborepo",
    "pnpm",
    "react",
    "nextjs",
    "expo",
    "tailwind",
    "shadcn",
    "seo",
    "llms-txt",
    "go",
    "rust",
    "python"
  ],
  "author": "Xocket Labs Inc. <hello@xocketlabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OceanLab-Technology/xocket.git"
  },
  "bugs": {
    "url": "https://github.com/OceanLab-Technology/xocket/issues"
  },
  "homepage": "https://github.com/OceanLab-Technology/xocket#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.20.0",
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "contributors": [
    "OceanLab Technology <hello@oceanlab.in>"
  ]
}
