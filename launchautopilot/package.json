{
  "name": "launchautopilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@xocket/eslint-config": "workspace:*",
    "@xocket/prettier-config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^5.9.3"
  },
  "prettier": "@xocket/prettier-config",
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "**/*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
